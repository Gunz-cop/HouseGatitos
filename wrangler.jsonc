{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "housegatitos",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}

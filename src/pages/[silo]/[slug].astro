---
// src/pages/[silo]/[slug].astro
// Genera las 75 páginas de posts individualmente bajo su silo correspondiente.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, buildJsonLdPost, buildBreadcrumbJsonLd, buildFaqJsonLd, SITE_URL } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = getPosts();
  return posts.map(post => ({
    params: { silo: post.silo.slug, slug: post.slug },
    props: { post, allPosts: posts }
  }));
}

const { post, allPosts } = Astro.props;

// Posts relacionados (mismo silo, excluye el actual, máx 3)
const related = allPosts
  .filter(p => p.silo.id === post.silo.id && p.slug !== post.slug)
  .slice(0, 3);

const jsonLd = [
  buildJsonLdPost(post),
  buildBreadcrumbJsonLd([
    { name: 'Inicio',        url: SITE_URL },
    { name: post.silo.name,  url: `${SITE_URL}/${post.silo.slug}/` },
    { name: post.title,      url: `${SITE_URL}/${post.silo.slug}/${post.slug}/` }
  ])
];

const faqSchema = buildFaqJsonLd(post.content || '');
if (faqSchema) {
  jsonLd.push(faqSchema);
}

// Slugify simple para tags
function slugifyTag(t) {
  return t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
}
---
<BaseLayout
  title={`${post.title} | House Gatitos`}
  description={post.description}
  canonical={`${SITE_URL}/${post.silo.slug}/${post.slug}/`}
  ogType="article"
  ogImage={post.featuredImg || '/assets/images/House Gatitos.webp'}
  articlePublished={post.published}
  articleModified={post.updated}
  jsonLd={jsonLd}
  activeSilo={post.silo.slug}
>

  <!-- ══ CABECERA DEL ARTÍCULO ══ -->
  <header class="post-hero">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav aria-label="Ruta de navegación" class="breadcrumb">
        <a href="/">Inicio</a>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        <a href={`/${post.silo.slug}/`}>{post.silo.icon} {post.silo.name}</a>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        <span aria-current="page">{post.title}</span>
      </nav>

      <!-- Meta -->
      <div class="post-meta">
        <span class="post-silo-badge">{post.silo.icon} {post.silo.name}</span>
        <time class="post-date-meta" datetime={post.published}>
          Publicado el {post.datePublished} · Por Equipo de House Gatitos
        </time>
      </div>

      <h1 class="post-title-h1">{post.title}</h1>
      <p class="post-description">{post.description}</p>
    </div>

    <!-- Imagen destacada -->
    {post.featuredImg && (
      <img
        src={post.featuredImg}
        alt={post.title}
        class="post-featured-img"
        width="1200"
        height="480"
        loading="eager"
        onerror="this.style.display='none'"
      >
    )}
  </header>

  <!-- ══ CONTENIDO PRINCIPAL ══ -->
  <main id="main-content">
    <div class="container">
      <article class="post-content" set:html={post.content} />

      <!-- Tags de categorías -->
      {post.categories.length > 0 && (
        <div class="post-tags" aria-label="Categorías">
          {post.categories.map(cat => (
            <span class="tag">{cat}</span>
          ))}
        </div>
      )}
    </div>
  </main>

  <!-- ══ POSTS RELACIONADOS ══ -->
  {related.length > 0 && (
    <section class="related-section" aria-label="Artículos relacionados">
      <div class="container">
        <h2 class="section-title" style="margin-bottom:0.5rem">También puede interesarte</h2>
        <p style="color:var(--clr-text-muted);font-size:0.9rem;margin-bottom:1.5rem">
          Más sobre {post.silo.name}
        </p>
        <div class="related-grid">
          {related.map(r => (
            <a href={`/${r.silo.slug}/${r.slug}/`} class="related-card">
              {r.featuredImg
                ? <img src={r.featuredImgCard} alt={r.title} loading="lazy">
                : <div class="related-card-placeholder"></div>
              }
              <p>{r.title}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

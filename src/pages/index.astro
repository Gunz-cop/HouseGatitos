</style>

<script is:inline>
  // ── Buscador ─────────────────────────────────────────────────────────
  let searchData = [];
  async function loadSearchIndex() {
    try {
      const res = await fetch('/search-index.json');
      searchData = await res.json();
    } catch {}
  }

  const searchInput = document.getElementById('searchInput');
  const searchResults = document.getElementById('searchResults');
  const searchBtn = document.getElementById('searchBtn');

  if (searchBtn) {
    searchBtn.addEventListener('click', () => {
      searchInput.focus();
    });
  }

  function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  searchInput.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    if (q.length < 2) { searchResults.classList.remove('visible'); return; }
    const matches = searchData
      .filter(p =>
        p.title.toLowerCase().includes(q) ||
        p.description.toLowerCase().includes(q) ||
        p.categories?.some(c => c.toLowerCase().includes(q))
      )
      .slice(0, 8);
    if (!matches.length) {
      searchResults.classList.remove('visible');
      return;
    }
    searchResults.innerHTML = matches.map(m => `
      <a href="/${m.silo?.slug || 'guias'}/${m.slug}/" class="search-result-item" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;border-bottom:1px solid var(--clr-border);text-decoration:none;color:inherit;">
        ${m.featuredImg
          ? `<img src="${m.featuredImg}" alt="" style="width:44px;height:44px;object-fit:cover;border-radius:var(--radius-sm);flex-shrink:0;background:var(--clr-surface);" loading="lazy" width="44" height="44">`
          : `<div style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;background:var(--clr-surface);border-radius:var(--radius-sm);">${m.silo?.icon || '🐱'}</div>`
        }
        <div style="min-width: 0;">
          <p style="font-weight:600;font-size:0.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0;">${escHtml(m.title)}</p>
          <p style="font-size:0.78rem;color:var(--clr-text-muted);margin:0;">${m.siloName || ''}</p>
        </div>
      </a>
    `).join('');
    searchResults.classList.add('visible');
  });

  document.addEventListener('click', e => {
    if (!searchResults.contains(e.target) && e.target !== searchInput) {
      searchResults.classList.remove('visible');
    }
  });

  searchInput.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      searchResults.classList.remove('visible');
      searchInput.value = '';
    }
  });

  // ── Checklist diario de Rituales ──────────────────────────────────────
  const CHECKLIST_TASKS = [
    { id: 'water',  text: 'Cambiar el agua',           note: 'Siempre fresca, en un recipiente limpio y separado de su comida.' },
    { id: 'food',   text: 'Dar la ración del día',     note: 'Calculada exactamente según peso, edad y actividad.' },
    { id: 'litter', text: 'Limpiar el arenero',        note: 'Retirar aglomerados al menos una vez al día para evitar rechazo.' },
    { id: 'play',   text: 'Sesión de juego interactivo',note: '15 minutos simulando el ciclo de caza con caña o plumas.' },
    { id: 'brush',  text: 'Revisar pelaje / cepillar', note: 'Especialmente importante en mantos largos para evitar nudos.' },
    { id: 'check',  text: 'Observar su comportamiento',note: 'Prestar atención a cambios de apetito, letargo u ocultamiento.' },
  ];

  const STORAGE_KEY = 'hg-checklist-' + new Date().toDateString();

  function loadChecklist() {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    const container = document.getElementById('checklistItems');
    container.innerHTML = CHECKLIST_TASKS.map(t => {
      const checked = saved[t.id] || false;
      return `
        <label class="checklist-item${checked ? ' done' : ''}" for="chk-${t.id}" style="display:flex; align-items:center; gap:0.9rem; cursor:pointer;">
          <input type="checkbox" id="chk-${t.id}" data-id="${t.id}" ${checked ? 'checked' : ''} style="display:none;">
          <div class="checklist-item-checkbox-wrap"></div>
          <div class="checklist-item-content">
            <span class="checklist-item-text" style="font-weight:500;">${t.text}</span>
            <span class="checklist-item-note" style="font-size:0.82rem; color:var(--clr-text-muted); display:block; margin-top:0.15rem;">${t.note}</span>
          </div>
        </label>
      `;
    }).join('');
    updateProgress(saved);
    container.querySelectorAll('input[type="checkbox"]').forEach(cb => {
      cb.addEventListener('change', () => {
        const saved2 = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        saved2[cb.dataset.id] = cb.checked;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(saved2));
        cb.closest('.checklist-item').classList.toggle('done', cb.checked);
        updateProgress(saved2);
      });
    });
  }

  function updateProgress(state) {
    const done = Object.values(state).filter(Boolean).length;
    const pct = Math.round((done / CHECKLIST_TASKS.length) * 100);
    const progressBar = document.getElementById('checkProgress');
    if (progressBar) progressBar.style.width = pct + '%';
  }

  const resetBtn = document.getElementById('checklistReset');
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      localStorage.removeItem(STORAGE_KEY);
      loadChecklist();
    });
  }

  // ── Init ─────────────────────────────────────────────────────────────
  loadSearchIndex();
  loadChecklist();
</script>


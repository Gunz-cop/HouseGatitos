---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, SITE_URL } from '../lib/posts.js';

const allPosts = getPosts();

// 1. Calcular silos/counts dinámicos
const counts = { razas: 0, salud: 0, guias: 0, cultura: 0 };
allPosts.forEach(p => {
  if (p.silo && counts[p.silo.id] !== undefined) {
    counts[p.silo.id]++;
  }
});

// 2. Obtener artículos curados para Lecturas Críticas
const featuredSlugs = ['gato-maine-coon', 'que-come-un-gato-bebe', 'el-bosque-de-noruega', 'sintomas-gatos'];
const featuredPosts = featuredSlugs
  .map(slug => allPosts.find(p => p.slug === slug))
  .filter(Boolean);

const mainFeatured = featuredPosts.find(p => p.slug === 'sintomas-gatos') || featuredPosts[0];
const sideFeatured = featuredPosts.filter(p => p !== mainFeatured);

function formatDate(dateStr) {
  try {
    return new Date(dateStr).toLocaleDateString('es-ES', {
      day: 'numeric', month: 'long', year: 'numeric'
    });
  } catch { return dateStr; }
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'House Gatitos',
    url: SITE_URL,
    description: 'Centro de cuidado y soluciones felinas. Guías prácticas, herramientas y respuestas para tutores de gatos.',
    inLanguage: 'es',
    publisher: {
      '@type': 'Organization',
      name: 'House Gatitos',
      url: SITE_URL,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/assets/images/House Gatitos-01.png` }
    },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE_URL}/?q={search_term_string}` },
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'House Gatitos',
    url: SITE_URL,
    logo: `${SITE_URL}/assets/images/House Gatitos-01.png`,
    sameAs: [
      'https://www.youtube.com/channel/UCFLfdtZ45cjhbHURSavif-Q',
      'https://www.facebook.com/HouseGatitosOficial',
      'https://twitter.com/housegatitos'
    ]
  }
];
---
<BaseLayout
  title="House Gatitos 🐾 | Centro de Soluciones y Cuidado Felino"
  description="House Gatitos: guías de salud, comportamiento, nutrición, fichas de razas y herramientas de triaje clínico y raciones diarias diseñadas por expertos."
  canonical={`${SITE_URL}/`}
  jsonLd={jsonLd}
>

  <!-- ══ HERO ══ -->
  <section class="hero" aria-labelledby="hero-title" style="padding: 6.5rem 0 5.5rem; position: relative; overflow: hidden;">
    <!-- Elementos de fondo artísticos minimalistas -->
    <div aria-hidden="true" style="position: absolute; top: -10%; left: -5%; opacity: 0.025; font-size: 20rem; pointer-events: none; user-select: none;">🐾</div>
    <div aria-hidden="true" style="position: absolute; bottom: -10%; right: -5%; opacity: 0.025; font-size: 24rem; pointer-events: none; user-select: none;">🐾</div>
    
    <div class="container" style="position: relative; z-index: 1;">
      <div class="hero-tag" aria-hidden="true">🐾 Un santuario de bienestar para tu gato</div>
      <h1 id="hero-title" style="font-family: var(--ff-heading); font-size: clamp(2.2rem, 6vw, 3.8rem); font-weight: 500; line-height: 1.15; margin-bottom: 1.5rem;">
        Respuestas claras y <em>prácticas</em><br>para el bienestar felino
      </h1>
      <p class="hero-sub" style="font-size: 1.15rem; max-width: 620px; color: var(--clr-text-muted); margin-bottom: 2.5rem; line-height: 1.6;">
        Encuentra pautas clínicas, guías de comportamiento y herramientas interactivas diseñadas por expertos. Sin contenido superficial — utilidad real para el cuidado de tu gato.
      </p>

      <!-- Buscador Minimalista Rediseñado -->
      <div class="search-wrap" role="search" aria-label="Buscar artículos" style="max-width: 650px; margin-inline: auto;">
        <div style="display: flex; gap: 0.75rem; width: 100%;">
          <div style="position: relative; flex-grow: 1;">
            <span class="search-icon" aria-hidden="true" style="left: 1.25rem;">🔍</span>
            <input
              type="search"
              id="searchInput"
              placeholder="Busca síntomas, comportamiento, raciones o guías..."
              autocomplete="off"
              aria-label="Buscar en House Gatitos"
              aria-autocomplete="list"
              aria-controls="searchResults"
              style="padding: 0.9rem 1rem 0.9rem 3rem; border-radius: 999px; height: 56px; border: 1px solid var(--clr-border);"
            >
          </div>
          <button class="search-btn" id="searchBtn" aria-label="Buscar" style="height: 56px; padding-inline: 2rem; border-radius: 999px;">Buscar →</button>
        </div>
        <div id="searchResults" class="search-results" role="listbox" aria-label="Resultados de búsqueda"></div>
      </div>
    </div>
  </section>

  <!-- ══ LECTURAS CRÍTICAS (Curated Highlights) ══ -->
  <section class="posts-section" aria-labelledby="featured-title" style="padding: 6rem 0 5rem;">
    <div class="container">
      <header class="section-header" style="text-align: left; margin-bottom: 3.5rem;">
        <span class="section-label">Lecturas Críticas</span>
        <h2 class="section-title" id="featured-title" style="font-size: 2.2rem;">Guías esenciales y curadas</h2>
        <p style="color: var(--clr-text-muted); font-size: 1.05rem; margin-top: 0.5rem; max-width: 600px;">
          Investigaciones y guías de referencia clínica redactadas en profundidad por tutores y especialistas.
        </p>
      </header>

      <div class="featured-layout">
        <!-- Destacado Principal (Síntomas comunes) -->
        {mainFeatured && (
          <a href={`/${mainFeatured.silo.slug}/${mainFeatured.slug}/`} class="featured-main-card">
            <div class="featured-main-img">
              {mainFeatured.featuredImg ? (
                <img src={mainFeatured.featuredImg} alt={mainFeatured.title} loading="lazy" width="650" height="400">
              ) : (
                <div class="post-card-placeholder">{mainFeatured.silo.icon}</div>
              )}
            </div>
            <div class="featured-main-body">
              <span class="post-card-silo">
                {mainFeatured.silo.icon} {mainFeatured.silo.name}
              </span>
              <h3 style="font-family: var(--ff-heading); font-size: 1.85rem; line-height: 1.3; margin-block: 0.5rem 0.8rem; font-weight: 500;">
                {mainFeatured.title}
              </h3>
              <p style="color: var(--clr-text-muted); font-size: 0.95rem; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {mainFeatured.description}
              </p>
              <time style="font-size: 0.82rem; color: var(--clr-text-light); margin-top: 1rem; display: block;" datetime={mainFeatured.datePublished}>
                {formatDate(mainFeatured.datePublished)}
              </time>
            </div>
          </a>
        )}

        <!-- Destacados Secundarios (Lista vertical de 3) -->
        <div class="featured-side-list">
          {sideFeatured.map(post => (
            <a href={`/${post.silo.slug}/${post.slug}/`} class="featured-side-item">
              <div class="featured-side-img">
                {post.featuredImg ? (
                  <img src={post.featuredImg} alt={post.title} loading="lazy" width="110" height="110">
                ) : (
                  <div class="post-card-placeholder" style="font-size: 2rem;">{post.silo.icon}</div>
                )}
              </div>
              <div class="featured-side-body">
                <span style="color: var(--clr-primary); font-weight: 600; text-transform: uppercase; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                  {post.silo.icon} {post.silo.name}
                </span>
                <h4 class="featured-side-title" style="margin-block: 0.2rem 0.4rem; font-family: var(--ff-heading); font-size: 1.2rem; font-weight: 500;">{post.title}</h4>
                <p class="featured-side-desc">{post.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══ SILOS / 4 PILARES ══ -->
  <section class="silos-section" aria-labelledby="silos-title" style="background: var(--clr-bg-alt); padding: 6rem 0;">
    <div class="container">
      <header class="section-header" style="text-align: center; margin-bottom: 4rem;">
        <span class="section-label">Explora el archivo</span>
        <h2 class="section-title" id="silos-title" style="font-size: 2.2rem;">¿Qué necesita tu gato hoy?</h2>
        <p style="color: var(--clr-text-muted); font-size: 1.05rem; max-width: 580px; margin-inline: auto; margin-top: 0.5rem;">
          Accede a todos nuestros artículos clasificados por silos de contenido especializados.
        </p>
      </header>

      <div class="silos-grid">
        <a href="/razas/" class="silo-asymmetric-card animate-in" data-silo="razas">
          <span class="silo-icon" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;">🐱</span>
          <h3 class="silo-asymmetric-title">Razas y Morfología</h3>
          <p class="silo-asymmetric-desc">Fichas de comportamiento, pelaje, alimentación y compatibilidad de razas comunes y exóticas.</p>
          <span class="silo-count" style="margin-top: 1.5rem; font-weight: 600; color: var(--clr-primary); font-size: 0.9rem;">Ver {counts.razas} artículos →</span>
        </a>

        <a href="/salud/" class="silo-asymmetric-card animate-in" data-silo="salud">
          <span class="silo-icon" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;">🩺</span>
          <h3 class="silo-asymmetric-title">Salud y Síntomas</h3>
          <p class="silo-asymmetric-desc">Prevención, triaje rápido, signos de malestar y guías ante situaciones clínicas de emergencia.</p>
          <span class="silo-count" style="margin-top: 1.5rem; font-weight: 600; color: var(--clr-primary); font-size: 0.9rem;">Ver {counts.salud} artículos →</span>
        </a>

        <a href="/guias/" class="silo-asymmetric-card animate-in" data-silo="guias">
          <span class="silo-icon" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;">📚</span>
          <h3 class="silo-asymmetric-title">Guías y Recursos</h3>
          <p class="silo-asymmetric-desc">Tutoriales prácticos de equipamiento, rascadores, higiene en casa y manuales interactivos.</p>
          <span class="silo-count" style="margin-top: 1.5rem; font-weight: 600; color: var(--clr-primary); font-size: 0.9rem;">Ver {counts.guias} artículos →</span>
        </a>

        <a href="/curiosidades/" class="silo-asymmetric-card animate-in" data-silo="cultura">
          <span class="silo-icon" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;">✨</span>
          <h3 class="silo-asymmetric-title">Curiosidades y Cultura</h3>
          <p class="silo-asymmetric-desc">Historias, literatura y anécdotas célebres sobre la conexión emocional entre humanos y felinos.</p>
          <span class="silo-count" style="margin-top: 1.5rem; font-weight: 600; color: var(--clr-primary); font-size: 0.9rem;">Ver {counts.cultura} artículos →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ HERRAMIENTAS INTERACTIVAS ══ -->
  <section class="tools-section" aria-labelledby="tools-title" style="padding: 6rem 0;">
    <div class="container">
      <header class="section-header" style="text-align: center; margin-bottom: 4rem;">
        <span class="section-label">Herramientas Especiales</span>
        <h2 class="section-title" id="tools-title" style="font-size: 2.2rem;">Herramientas Clínicas y de Cuidado</h2>
        <p style="color: var(--clr-text-muted); font-size: 1.05rem; max-width: 580px; margin-inline: auto; margin-top: 0.5rem;">
          Pautas y asistentes automatizados gratuitos para monitorear la salud y nutrición diaria de tu felino.
        </p>
      </header>

      <div class="tools-editorial-grid">
        <a href="/calculadora-comida-gatos/" class="tool-editorial-card">
          <span class="tool-editorial-icon">🍽️</span>
          <h3 class="tool-editorial-title">Calculadora de Raciones</h3>
          <p class="tool-editorial-desc">
            Calcula la porción exacta (seca y húmeda) en base a su nivel de actividad, edad y peso corporal para prevenir la lipidosis hepática y obesidad.
          </p>
          <span class="tool-editorial-action">Acceder a la calculadora →</span>
        </a>

        <a href="/salud/sintomas-gatos/" class="tool-editorial-card">
          <span class="tool-editorial-icon">🩺</span>
          <h3 class="tool-editorial-title">Guía de Síntomas Urgentes</h3>
          <p class="tool-editorial-desc">
            Protocolo de triaje completo para examinar el TRC, la frecuencia cardíaca y la temperatura de tu felino antes de contactar a tu clínica.
          </p>
          <span class="tool-editorial-action">Ver guía de triaje →</span>
        </a>
      </div>

      <!-- Checklist de Rituales Diarios -->
      <div class="checklist-widget premium-ritual" style="margin-top: 5rem;">
        <div class="checklist-header-inline">
          <h3 style="font-family: var(--ff-heading); font-size: 1.6rem; font-weight: 500;">Rituales Diarios del Felino</h3>
          <div class="checklist-period-badge">
            <span>🐾</span> Consistencia es amor
          </div>
        </div>
        <p style="color: var(--clr-text-muted); font-size: 0.92rem; margin-bottom: 1.5rem; line-height: 1.5;">
          Marca cada una de las actividades indispensables para mantener el bienestar físico y mental de tu compañero. Tu progreso se guarda automáticamente en el navegador.
        </p>

        <div class="checklist-progress" aria-hidden="true" style="margin-bottom: 1.8rem; background: var(--clr-surface); height: 6px; border-radius: 999px; overflow: hidden;">
          <div class="checklist-progress-bar" id="checkProgress" style="width:0%; height: 100%; background: var(--clr-primary); transition: width 0.4s ease;"></div>
        </div>

        <div id="checklistItems" style="display: flex; flex-direction: column; gap: 0.5rem;">
          <!-- Generado dinámicamente por JS en el cliente -->
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">
          <button class="checklist-reset" id="checklistReset" style="width: auto; padding: 0.6rem 1.5rem; border-radius: 999px; cursor: pointer; transition: background 0.2s;">🔄 Reiniciar rituales</button>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script is:inline>
  // ── Buscador ─────────────────────────────────────────────────────────
  let searchData = [];
  async function loadSearchIndex() {
    try {
      const res = await fetch('/search-index.json');
      searchData = await res.json();
    } catch {}
  }

  const searchInput = document.getElementById('searchInput');
  const searchResults = document.getElementById('searchResults');
  const searchBtn = document.getElementById('searchBtn');

  if (searchBtn) {
    searchBtn.addEventListener('click', () => {
      searchInput.focus();
    });
  }

  function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  searchInput.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    if (q.length < 2) { searchResults.classList.remove('visible'); return; }
    const matches = searchData
      .filter(p =>
        p.title.toLowerCase().includes(q) ||
        p.description.toLowerCase().includes(q) ||
        p.categories?.some(c => c.toLowerCase().includes(q))
      )
      .slice(0, 8);
    if (!matches.length) {
      searchResults.classList.remove('visible');
      return;
    }
    searchResults.innerHTML = matches.map(m => `
      <a href="/${m.silo?.slug || 'guias'}/${m.slug}/" class="search-result-item">
        ${m.featuredImg
          ? `<img src="${m.featuredImg}" alt="" class="search-result-img" loading="lazy" width="44" height="44">`
          : `<div class="search-result-img" style="display:flex;align-items:center;justify-content:center;font-size:1.4rem">${m.silo?.icon || '🐱'}</div>`
        }
        <div class="search-result-info">
          <p class="search-result-title">${escHtml(m.title)}</p>
          <p class="search-result-silo">${m.siloName || ''}</p>
        </div>
      </a>
    `).join('');
    searchResults.classList.add('visible');
  });

  document.addEventListener('click', e => {
    if (!searchResults.contains(e.target) && e.target !== searchInput) {
      searchResults.classList.remove('visible');
    }
  });

  searchInput.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      searchResults.classList.remove('visible');
      searchInput.value = '';
    }
  });

  // ── Checklist diario de Rituales ──────────────────────────────────────
  const CHECKLIST_TASKS = [
    { id: 'water',  text: 'Cambiar el agua',           note: 'Siempre fresca, en un recipiente limpio y separado de su comida.' },
    { id: 'food',   text: 'Dar la ración del día',     note: 'Calculada exactamente según peso, edad y actividad.' },
    { id: 'litter', text: 'Limpiar el arenero',        note: 'Retirar aglomerados al menos una vez al día para evitar rechazo.' },
    { id: 'play',   text: 'Sesión de juego interactivo',note: '15 minutos simulando el ciclo de caza con caña o plumas.' },
    { id: 'brush',  text: 'Revisar pelaje / cepillar', note: 'Especialmente importante en mantos largos para evitar nudos.' },
    { id: 'check',  text: 'Observar su comportamiento',note: 'Prestar atención a cambios de apetito, letargo u ocultamiento.' },
  ];

  const STORAGE_KEY = 'hg-checklist-' + new Date().toDateString();

  function loadChecklist() {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    const container = document.getElementById('checklistItems');
    container.innerHTML = CHECKLIST_TASKS.map(t => {
      const checked = saved[t.id] || false;
      return `
        <label class="checklist-item${checked ? ' done' : ''}" for="chk-${t.id}" style="display:flex; align-items:center; gap:0.9rem; padding-block:0.8rem; cursor:pointer;">
          <input type="checkbox" id="chk-${t.id}" data-id="${t.id}" ${checked ? 'checked' : ''} style="display:none;">
          <div class="checklist-item-checkbox-wrap"></div>
          <div class="checklist-item-content">
            <span class="checklist-item-text" style="font-weight:500;">${t.text}</span>
            <span class="checklist-item-note" style="font-size:0.82rem; color:var(--clr-text-muted); display:block; margin-top:0.15rem;">${t.note}</span>
          </div>
        </label>
      `;
    }).join('');
    updateProgress(saved);
    container.querySelectorAll('input[type="checkbox"]').forEach(cb => {
      cb.addEventListener('change', () => {
        const saved2 = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        saved2[cb.dataset.id] = cb.checked;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(saved2));
        cb.closest('.checklist-item').classList.toggle('done', cb.checked);
        updateProgress(saved2);
      });
    });
  }

  function updateProgress(state) {
    const done = Object.values(state).filter(Boolean).length;
    const pct = Math.round((done / CHECKLIST_TASKS.length) * 100);
    const progressBar = document.getElementById('checkProgress');
    if (progressBar) progressBar.style.width = pct + '%';
  }

  const resetBtn = document.getElementById('checklistReset');
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      localStorage.removeItem(STORAGE_KEY);
      loadChecklist();
    });
  }

  // ── Init ─────────────────────────────────────────────────────────────
  loadSearchIndex();
  loadChecklist();
</script>

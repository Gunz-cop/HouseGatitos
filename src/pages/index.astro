---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, SITE_URL } from '../lib/posts.js';

const allPosts = getPosts();

// 1. Calcular silos/counts dinámicos
const counts = { razas: 0, salud: 0, guias: 0, cultura: 0 };
allPosts.forEach(p => {
  if (p.silo && counts[p.silo.id] !== undefined) {
    counts[p.silo.id]++;
  }
});

// 2. Obtener artículos curados para Lecturas Críticas
const featuredSlugs = ['gato-maine-coon', 'que-come-un-gato-bebe', 'el-bosque-de-noruega', 'sintomas-gatos'];
const featuredPosts = featuredSlugs
  .map(slug => allPosts.find(p => p.slug === slug))
  .filter(Boolean);

const mainFeatured = featuredPosts.find(p => p.slug === 'sintomas-gatos') || featuredPosts[0];
const sideFeatured = featuredPosts.filter(p => p !== mainFeatured);

function formatDate(dateStr) {
  try {
    return new Date(dateStr).toLocaleDateString('es-ES', {
      day: 'numeric', month: 'long', year: 'numeric'
    });
  } catch { return dateStr; }
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'House Gatitos',
    url: SITE_URL,
    description: 'Centro de cuidado y soluciones felinas. Guías prácticas, herramientas y respuestas para tutores de gatos.',
    inLanguage: 'es',
    publisher: {
      '@type': 'Organization',
      name: 'House Gatitos',
      url: SITE_URL,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/assets/images/House Gatitos-01.png` }
    },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE_URL}/?q={search_term_string}` },
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'House Gatitos',
    url: SITE_URL,
    logo: `${SITE_URL}/assets/images/House Gatitos-01.png`,
    sameAs: [
      'https://www.youtube.com/channel/UCFLfdtZ45cjhbHURSavif-Q',
      'https://www.facebook.com/HouseGatitosOficial',
      'https://twitter.com/housegatitos'
    ]
  }
];
---
<BaseLayout
  title="House Gatitos 🐾 | Centro de Soluciones y Cuidado Felino"
  description="House Gatitos: guías de salud, comportamiento, nutrición, fichas de razas y herramientas de triaje clínico y raciones diarias diseñadas por expertos."
  canonical={`${SITE_URL}/`}
  jsonLd={jsonLd}
>

  <!-- ══ HERO EDITORIAL ══ -->
  <section class="hero-editorial" aria-labelledby="hero-title">
    <div class="container hero-editorial-grid">
      <div class="hero-main-content">
        <span class="editorial-tag">REFERENCIA Felina & CUIDADO CLÍNICO</span>
        <h1 id="hero-title">
          Criterio clínico y <em>respuestas claras</em> para el bienestar de tu gato.
        </h1>
        <p class="hero-editorial-sub">
          Encuentra pautas clínicas estructuradas, guías de comportamiento en profundidad y herramientas interactivas de triaje diseñadas por especialistas.
        </p>

        <!-- Buscador Minimalista Tipo Revista -->
        <div class="search-box-editorial" role="search" aria-label="Buscar en el archivo">
          <div class="search-input-wrapper">
            <span class="search-prefix-icon" aria-hidden="true">🔍</span>
            <input
              type="search"
              id="searchInput"
              placeholder="Busca síntomas, comportamiento, raciones o guías..."
              autocomplete="off"
              aria-label="Buscar en House Gatitos"
              aria-autocomplete="list"
              aria-controls="searchResults"
            >
          </div>
          <button class="search-submit-btn" id="searchBtn" aria-label="Buscar">Buscar en el Archivo →</button>
          <div id="searchResults" class="search-results-overlay" role="listbox" aria-label="Resultados de búsqueda"></div>
        </div>
      </div>

      <div class="hero-editorial-sidebar" aria-hidden="true">
        <div class="editorial-quote-box">
          <span class="quote-label">Lectura Recomendada</span>
          <p class="quote-text">
            “El bienestar de un felino empieza por comprender que su silencio a menudo enmascara malestar. Aprender a observar es el primer paso clínico del tutor.”
          </p>
          <div class="quote-footer">
            <a href="/salud/sintomas-gatos/" class="quote-link">Ver Guía de Triaje Clínico →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ LECTURAS CRÍTICAS (Editorial Layout) ══ -->
  <section class="lecturas-criticas-section" aria-labelledby="featured-title">
    <div class="container">
      <header class="editorial-section-header">
        <div class="header-line"></div>
        <div class="header-title-row">
          <span class="section-num">I.</span>
          <h2 class="editorial-section-title" id="featured-title">Lecturas Críticas</h2>
          <span class="section-subtitle-editorial">Artículos esenciales seleccionados por el equipo editorial</span>
        </div>
      </header>

      <div class="featured-editorial-grid">
        <!-- Destacado Principal -->
        {mainFeatured && (
          <a href={`/${mainFeatured.silo.slug}/${mainFeatured.slug}/`} class="featured-editorial-card">
            <div class="featured-editorial-img-wrapper">
              {mainFeatured.featuredImg ? (
                <img src={mainFeatured.featuredImgCard} alt={mainFeatured.title} loading="lazy" width="650" height="400">
              ) : (
                <div class="editorial-placeholder">{mainFeatured.silo.icon}</div>
              )}
              <span class="editorial-silo-badge" data-silo={mainFeatured.silo.id}>
                {mainFeatured.silo.icon} {mainFeatured.silo.name}
              </span>
            </div>
            <div class="featured-editorial-body">
              <h3 class="featured-editorial-title">
                {mainFeatured.title}
              </h3>
              <p class="featured-editorial-desc">
                {mainFeatured.description}
              </p>
              <div class="featured-editorial-meta">
                <time datetime={mainFeatured.datePublished}>
                  Publicado el {formatDate(mainFeatured.datePublished)}
                </time>
                <span class="read-more-text">Leer Artículo Completo ↗</span>
              </div>
            </div>
          </a>
        )}

        <!-- Destacados Secundarios -->
        <div class="featured-editorial-list">
          {sideFeatured.map(post => (
            <a href={`/${post.silo.slug}/${post.slug}/`} class="featured-editorial-item">
              <div class="featured-editorial-item-body">
                <span class="featured-editorial-item-silo" data-silo={post.silo.id}>
                  {post.silo.icon} {post.silo.name}
                </span>
                <h4 class="featured-editorial-item-title">{post.title}</h4>
                <p class="featured-editorial-item-desc">{post.description}</p>
                <span class="featured-editorial-item-link">Leer guía →</span>
              </div>
              <div class="featured-editorial-item-img">
                {post.featuredImg ? (
                  <img src={post.featuredImgThumb} alt={post.title} loading="lazy" width="110" height="110">
                ) : (
                  <div class="editorial-placeholder-thumb">{post.silo.icon}</div>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══ EL ARCHIVO (Índice de Secciones) ══ -->
  <section class="archivo-index-section" aria-labelledby="silos-title">
    <div class="container">
      <header class="editorial-section-header">
        <div class="header-line"></div>
        <div class="header-title-row">
          <span class="section-num">II.</span>
          <h2 class="editorial-section-title" id="silos-title">El Archivo</h2>
          <span class="section-subtitle-editorial">Artículos clasificados por pilares de conocimiento</span>
        </div>
      </header>

      <div class="archivo-index-list">
        <!-- Fila Razas -->
        <a href="/razas/" class="archivo-index-row" data-silo="razas">
          <div class="archivo-col-num">01</div>
          <div class="archivo-col-main">
            <h3 class="archivo-row-title">Razas y Morfología</h3>
            <p class="archivo-row-desc">Fichas de comportamiento, genética, pelaje, alimentación específica y compatibilidad.</p>
          </div>
          <div class="archivo-col-meta">
            <span class="archivo-row-count">{counts.razas} guías</span>
            <span class="archivo-row-arrow">↗</span>
          </div>
        </a>

        <!-- Fila Salud -->
        <a href="/salud/" class="archivo-index-row" data-silo="salud">
          <div class="archivo-col-num">02</div>
          <div class="archivo-col-main">
            <h3 class="archivo-row-title">Salud y Sintomatología</h3>
            <p class="archivo-row-desc">Prevención, primeros auxilios, signos comunes de malestar y guías ante situaciones clínicas.</p>
          </div>
          <div class="archivo-col-meta">
            <span class="archivo-row-count">{counts.salud} guías</span>
            <span class="archivo-row-arrow">↗</span>
          </div>
        </a>

        <!-- Fila Guías -->
        <a href="/guias/" class="archivo-index-row" data-silo="guias">
          <div class="archivo-col-num">03</div>
          <div class="archivo-col-main">
            <h3 class="archivo-row-title">Guías y Recursos</h3>
            <p class="archivo-row-desc">Tutoriales prácticos sobre equipamiento felino, rascadores adecuados y rutinas higiénicas.</p>
          </div>
          <div class="archivo-col-meta">
            <span class="archivo-row-count">{counts.guias} guías</span>
            <span class="archivo-row-arrow">↗</span>
          </div>
        </a>

        <!-- Fila Curiosidades -->
        <a href="/curiosidades/" class="archivo-index-row" data-silo="cultura">
          <div class="archivo-col-num">04</div>
          <div class="archivo-col-main">
            <h3 class="archivo-row-title">Curiosidades y Cultura</h3>
            <p class="archivo-row-desc">El vínculo histórico y emocional humano-felino. Anécdotas, literatura y ciencia del comportamiento.</p>
          </div>
          <div class="archivo-col-meta">
            <span class="archivo-row-count">{counts.cultura} guías</span>
            <span class="archivo-row-arrow">↗</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ DIARIO FELINO & HERRAMIENTAS ══ -->
  <section class="diario-herramientas-section" aria-labelledby="tools-title">
    <div class="container">
      <header class="editorial-section-header">
        <div class="header-line"></div>
        <div class="header-title-row">
          <span class="section-num">III.</span>
          <h2 class="editorial-section-title" id="tools-title">Fichas Técnicas & Registro</h2>
          <span class="section-subtitle-editorial">Herramientas gratuitas para el monitoreo de tu gato</span>
        </div>
      </header>

      <div class="diario-herramientas-grid">
        <!-- Columna Herramientas -->
        <div class="herramientas-column">
          <div class="herramienta-ficha">
            <span class="ficha-badge">Asistente Clínico</span>
            <h3 class="ficha-title">Calculadora de Raciones Diarias</h3>
            <p class="ficha-desc">
              Determina con exactitud la dosis diaria recomendada de alimento seco y húmedo según peso, edad y actividad, previniendo patologías metabólicas comunes.
            </p>
            <a href="/calculadora-comida-gatos/" class="ficha-link">Abrir calculadora →</a>
          </div>

          <div class="herramienta-ficha">
            <span class="ficha-badge">Manual de Emergencias</span>
            <h3 class="ficha-title">Guía de Triaje y Monitoreo</h3>
            <p class="ficha-desc">
              Aprende a medir constantes críticas (frecuencia respiratoria, tiempo de llenado capilar, hidratación) antes de contactar a tu clínica veterinaria.
            </p>
            <a href="/salud/sintomas-gatos/" class="ficha-link">Ver protocolo de examen →</a>
          </div>
        </div>

        <!-- Columna Diario Checklist (Rituales) -->
        <div class="diario-checklist-column">
          <div class="diario-checklist-card">
            <div class="diario-checklist-header">
              <div>
                <h3 class="diario-card-title">Rituales Diarios del Felino</h3>
                <span class="diario-card-subtitle">Bitácora de cuidados indispensables de hoy</span>
              </div>
              <div class="diario-card-badge">🐾 Rutina de Amor</div>
            </div>
            
            <div class="diario-progress-bar-container" aria-hidden="true">
              <div class="diario-progress-bar" id="checkProgress" style="width:0%;"></div>
            </div>

            <div id="checklistItems" class="diario-items-list">
              <!-- Cargado dinámicamente -->
            </div>

            <div class="diario-checklist-footer">
              <button class="diario-reset-btn" id="checklistReset">🔄 Reiniciar bitácora</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<!-- ══ ESTILOS EDITORIALES DE LA HOME ══ -->
<style>
  /* --- Hero Editorial --- */
  .hero-editorial {
    padding: 7rem 0 6rem;
    background: var(--clr-bg);
    border-bottom: 1px solid var(--clr-border);
    position: relative;
  }
  .hero-editorial::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: radial-gradient(var(--clr-border) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.15;
    pointer-events: none;
  }
  .hero-editorial-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .hero-main-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .editorial-tag {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--clr-primary);
    margin-bottom: 1.25rem;
  }
  .hero-editorial h1 {
    font-family: var(--ff-heading);
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    font-weight: 500;
    line-height: 1.15;
    color: var(--clr-text);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }
  .hero-editorial h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--clr-primary);
  }
  .hero-editorial-sub {
    font-size: 1.15rem;
    color: var(--clr-text-muted);
    line-height: 1.65;
    max-width: 640px;
    margin-bottom: 3rem;
  }

  /* Buscador tipo revista */
  .search-box-editorial {
    width: 100%;
    max-width: 680px;
    display: flex;
    gap: 1rem;
    position: relative;
  }
  .search-input-wrapper {
    position: relative;
    flex-grow: 1;
  }
  .search-prefix-icon {
    position: absolute;
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--clr-text-light);
    font-size: 1.1rem;
    pointer-events: none;
  }
  .search-box-editorial input {
    width: 100%;
    height: 56px;
    padding: 0.5rem 1rem 0.5rem 3.25rem;
    border: none;
    border-bottom: 2px solid var(--clr-border);
    background: transparent;
    color: var(--clr-text);
    font-family: var(--ff-body);
    font-size: 1.05rem;
    transition: var(--transition);
    outline: none;
  }
  .search-box-editorial input:focus {
    border-color: var(--clr-primary);
  }
  .search-submit-btn {
    height: 56px;
    padding: 0 2rem;
    background: var(--clr-bg-card);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-sm);
    color: var(--clr-text);
    font-family: var(--ff-body);
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
  }
  .search-submit-btn:hover {
    background: var(--clr-primary-bg);
    border-color: var(--clr-primary);
    color: var(--clr-primary);
  }
  .search-results-overlay {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    background: var(--clr-bg-card);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    max-height: 380px;
    overflow-y: auto;
    z-index: 99;
    display: none;
  }
  .search-results-overlay.visible {
    display: block;
  }

  /* Sidebar Cita Hero */
  .hero-editorial-sidebar {
    padding-left: 2rem;
    border-left: 1px solid var(--clr-border);
  }
  .editorial-quote-box {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .quote-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clr-text-light);
  }
  .quote-text {
    font-family: var(--ff-heading);
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--clr-text-muted);
    font-style: italic;
  }
  .quote-footer {
    margin-top: 0.5rem;
  }
  .quote-link {
    font-weight: 600;
    color: var(--clr-primary);
    font-size: 0.9rem;
    transition: var(--transition);
  }
  .quote-link:hover {
    color: var(--clr-primary-lt);
    text-decoration: underline;
  }

  /* --- Estructura Secciones Editoriales --- */
  .editorial-section-header {
    margin-bottom: 3.5rem;
  }
  .header-line {
    height: 1px;
    background: var(--clr-border);
    margin-bottom: 1.5rem;
  }
  .header-title-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .section-num {
    font-family: var(--ff-heading);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--clr-primary);
    font-style: italic;
  }
  .editorial-section-title {
    font-family: var(--ff-heading);
    font-size: 2.2rem;
    font-weight: 500;
    color: var(--clr-text);
  }
  .section-subtitle-editorial {
    font-size: 0.95rem;
    color: var(--clr-text-muted);
    margin-left: auto;
  }

  /* --- Lecturas Críticas Grid --- */
  .lecturas-criticas-section {
    padding: 6rem 0 5rem;
  }
  .featured-editorial-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
  }
  .featured-editorial-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: var(--transition);
  }
  .featured-editorial-img-wrapper {
    aspect-ratio: 16/10;
    position: relative;
    overflow: hidden;
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
  }
  .featured-editorial-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .featured-editorial-card:hover .featured-editorial-img-wrapper img {
    transform: scale(1.02);
  }
  .editorial-silo-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: var(--clr-bg-card);
    border: 1px solid var(--clr-border);
    padding: 0.35rem 0.8rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--clr-text);
  }
  .featured-editorial-body {
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .featured-editorial-title {
    font-family: var(--ff-heading);
    font-size: 1.85rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--clr-text);
    transition: color var(--transition);
  }
  .featured-editorial-card:hover .featured-editorial-title {
    color: var(--clr-primary);
  }
  .featured-editorial-desc {
    color: var(--clr-text-muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .featured-editorial-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.75rem;
    border-top: 1px solid var(--clr-border);
    padding-top: 1rem;
    font-size: 0.8rem;
    color: var(--clr-text-light);
  }
  .read-more-text {
    font-weight: 600;
    color: var(--clr-primary);
  }

  /* Artículos secundarios */
  .featured-editorial-list {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }
  .featured-editorial-item {
    display: flex;
    gap: 1.5rem;
    text-decoration: none;
    color: inherit;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--clr-border);
    transition: var(--transition);
  }
  .featured-editorial-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .featured-editorial-item-body {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .featured-editorial-item-silo {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--clr-primary);
  }
  .featured-editorial-item-title {
    font-family: var(--ff-heading);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--clr-text);
    transition: color var(--transition);
  }
  .featured-editorial-item:hover .featured-editorial-item-title {
    color: var(--clr-primary);
  }
  .featured-editorial-item-desc {
    font-size: 0.88rem;
    color: var(--clr-text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .featured-editorial-item-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--clr-primary);
    margin-top: 0.5rem;
  }
  .featured-editorial-item-img {
    width: 110px;
    height: 110px;
    flex-shrink: 0;
    border: 1px solid var(--clr-border);
    background: var(--clr-surface);
    overflow: hidden;
  }
  .featured-editorial-item-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

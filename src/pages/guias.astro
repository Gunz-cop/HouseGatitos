---
// src/pages/guias.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, buildBreadcrumbJsonLd, SITE_URL } from '../lib/posts.js';

const posts = getPosts().filter(p => p.silo.id === 'guias');
const siloName = 'Guías y Recursos';
const siloIcon = '📚';
const siloDesc = 'Tutoriales detallados, guías prácticas y herramientas para facilitarte el cuidado del gato en el día a día.';

// Seleccionar el post destacado (fuente-agua-gatos-elegir-mejor-opcion)
const featuredSlug = 'fuente-agua-gatos-elegir-mejor-opcion';
const featuredPost = posts.find(p => p.slug === featuredSlug) || posts[0];
const regularPosts = posts.filter(p => p.slug !== featuredPost.slug);

const jsonLd = buildBreadcrumbJsonLd([
  { name: 'Inicio', url: SITE_URL },
  { name: siloName, url: `${SITE_URL}/guias/` }
]);

function formatDate(dateStr) {
  try {
    return new Date(dateStr).toLocaleDateString('es-ES', {
      day: 'numeric', month: 'long', year: 'numeric'
    });
  } catch { return dateStr; }
}
---
<BaseLayout
  title={`${siloName} | House Gatitos`}
  description={`Explora artículos, guías y recursos prácticos sobre ${siloName} en House Gatitos. Soluciones reales para el cuidado felino.`}
  canonical={`${SITE_URL}/guias/`}
  jsonLd={jsonLd}
  activeSilo="guias"
>

  <header class="post-hero" style="text-align:center;">
    <div class="container">
      <nav aria-label="Ruta de navegación" class="breadcrumb" style="justify-content:center;">
        <a href="/">Inicio</a>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        <span aria-current="page">{siloName}</span>
      </nav>
      <div style="font-size:3.5rem; margin-bottom:1rem; display:inline-block;">{siloIcon}</div>
      <h1 class="post-title-h1" style="margin-inline:auto;">{siloName}</h1>
      <p class="post-description" style="margin-inline:auto;">{siloDesc}</p>
    </div>
  </header>

  <main id="main-content" style="padding:4rem 0;">
    <div class="container">
      
      <!-- Artículo Destacado Principal -->
      {featuredPost && (
        <a href={`/${featuredPost.silo.slug}/${featuredPost.slug}/`} class="silo-hero-featured">
          <div class="silo-featured-img">
            {featuredPost.featuredImg ? (
              <img src={featuredPost.featuredImgCard} alt={featuredPost.title} loading="lazy" width="650" height="400">
            ) : (
              <div class="post-card-placeholder">{featuredPost.silo.icon}</div>
            )}
          </div>
          <div class="silo-featured-body">
            <span class="silo-featured-badge">
              {featuredPost.silo.icon} Guía Destacada
            </span>
            <h2 class="silo-featured-title">{featuredPost.title}</h2>
            <p class="silo-featured-desc">{featuredPost.description}</p>
            <time class="silo-featured-date" datetime={featuredPost.datePublished}>
              {formatDate(featuredPost.datePublished)}
            </time>
          </div>
        </a>
      )}

      <!-- Título de Sección Secundaria -->
      <h2 class="silo-section-title">Manuales Prácticos y Comparativas</h2>

      <!-- Rejilla de Artículos Restantes -->
      <div class="posts-grid">
        {regularPosts.map(p => (
          <a href={`/${p.silo.slug}/${p.slug}/`} class="post-card animate-in" data-silo={p.silo.id}>
            <div class="post-card-img">
              {p.featuredImg
                ? <img src={p.featuredImgCard} alt={p.title} loading="lazy" width="400" height="225">
                : <div class="post-card-placeholder">{p.silo.icon}</div>
              }
            </div>
            <div class="post-card-body">
              <p class="post-card-silo">{p.silo.icon} {p.silo.name}</p>
              <h3 class="post-card-title">{p.title}</h3>
              <p class="post-card-desc">{p.description}</p>
              <time class="post-card-date" datetime={p.datePublished}>{formatDate(p.datePublished)}</time>
            </div>
          </a>
        ))}
      </div>
      
    </div>
  </main>

</BaseLayout>

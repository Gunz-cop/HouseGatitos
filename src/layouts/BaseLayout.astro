---
// src/layouts/BaseLayout.astro
// Layout base compartido por todas las páginas
import '../style.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: string;
  ogImage?: string;
  articlePublished?: string;
  articleModified?: string;
  jsonLd?: object | object[];
  activeSilo?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = '/assets/images/House Gatitos.webp',
  articlePublished,
  articleModified,
  jsonLd,
  activeSilo,
} = Astro.props;

const SITE_URL = 'https://housegatitos.com';
const ogImageFull = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Lora:ital,wght@0,400;0,600;1,400&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Lora:ital,wght@0,400;0,600;1,400&display=swap">
  </noscript>

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5094917394495886"
     crossorigin="anonymous"></script>

  <!-- Open Graph -->
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageFull}>
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content="House Gatitos">
  {articlePublished && <meta property="article:published_time" content={articlePublished}>}
  {articleModified  && <meta property="article:modified_time"  content={articleModified}>}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@housegatitos">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageFull}>

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/assets/images/House Gatitos-AMP.png" type="image/png">

  <!-- CSS global se maneja por importación de Astro -->

  <!-- JSON-LD -->
  {jsonLd && (
    Array.isArray(jsonLd)
      ? jsonLd.map(ld => <script type="application/ld+json" set:html={JSON.stringify(ld, null, 2)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />
  )}

  <!-- Evitar FOUC aplicando el tema guardado inmediatamente -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('hg-theme');
      if (saved === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
</head>
<body data-silo-theme={activeSilo}>

  <!-- ══ NAV ══ -->
  <nav class="site-nav" aria-label="Navegación principal">
    <div class="container nav-inner">
      <a href="/" class="nav-logo" aria-current={!activeSilo ? 'page' : undefined}>
        <img src="/assets/images/House Gatitos-01.png" alt="House Gatitos logo" width="36" height="36">
        House <span>Gatitos</span>
      </a>
      <ul class="nav-links">
        <li><a href="/razas/"        aria-current={activeSilo === 'razas'         ? 'page' : undefined}>🐱 Razas</a></li>
        <li><a href="/salud/"        aria-current={activeSilo === 'salud'         ? 'page' : undefined}>🩺 Salud</a></li>
        <li><a href="/guias/"        aria-current={activeSilo === 'guias'         ? 'page' : undefined}>📚 Guías</a></li>
        <li><a href="/curiosidades/" aria-current={activeSilo === 'curiosidades'  ? 'page' : undefined}>✨ Curiosidades</a></li>
      </ul>
      <div class="nav-actions">
        <button class="btn-theme" id="themeToggle" aria-label="Cambiar tema" title="Cambiar modo claro/oscuro">🌙</button>
      </div>
    </div>
  </nav>

  <slot />

  <!-- ══ FOOTER ══ -->
  <footer class="site-footer" aria-label="Pie de página">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a href="/" class="footer-brand-logo">
            <img src="/assets/images/House Gatitos-01.png" alt="House Gatitos" width="32" height="32">
            House Gatitos
          </a>
          <p class="footer-tagline">Tu centro de soluciones y cuidado felino. Respuestas prácticas para tutores comprometidos con el bienestar de sus gatos.</p>
        </div>
        <div>
          <p class="footer-col-title">Categorías</p>
          <ul class="footer-links">
            <li><a href="/razas/">🐱 Razas y Morfología</a></li>
            <li><a href="/salud/">🩺 Salud y Síntomas</a></li>
            <li><a href="/guias/">📚 Guías y Recursos</a></li>
            <li><a href="/curiosidades/">✨ Curiosidades</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-col-title">Herramientas</p>
          <ul class="footer-links">
            <li><a href="/calculadora-comida-gatos/">🍽️ Calculadora de Raciones</a></li>
            <li><a href="/checklist-cuidados-diarios-gato/">✅ Checklist Diario</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-col-title">Legal</p>
          <ul class="footer-links">
            <li><a href="/aviso-legal/">Aviso Legal</a></li>
            <li><a href="/politicas-de-privacidad/">Privacidad</a></li>
            <li><a href="/cookies/">Cookies</a></li>
            <li><a href="/sobre-de-mi/">Acerca de</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2025 House Gatitos · Hecho con 🐾 para amantes de los gatos</p>
        <div class="footer-social" aria-label="Redes sociales">
          <a href="https://www.youtube.com/channel/UCFLfdtZ45cjhbHURSavif-Q" aria-label="YouTube" target="_blank" rel="noopener">▶</a>
          <a href="https://www.facebook.com/HouseGatitosOficial" aria-label="Facebook" target="_blank" rel="noopener">f</a>
          <a href="https://twitter.com/housegatitos" aria-label="Twitter / X" target="_blank" rel="noopener">𝕏</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Modo oscuro — inline para evitar FOUC -->
  <script is:inline>
    (function() {
      const themeToggle = document.getElementById('themeToggle');
      const saved = localStorage.getItem('hg-theme');
      if (saved === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
        if (themeToggle) themeToggle.textContent = '☀️';
      }
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (isDark) {
            document.documentElement.removeAttribute('data-theme');
            localStorage.setItem('hg-theme', 'light');
            themeToggle.textContent = '🌙';
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('hg-theme', 'dark');
            themeToggle.textContent = '☀️';
          }
        });
      }
    })();
  </script>

</body>
</html>
